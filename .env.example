# Copia a .env.local (no se sube al repo). Valores locales: `npx supabase status -o env`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Solo para tests E2E y scripts locales. Nunca en el frontend ni en el repo.
SUPABASE_SECRET_KEY=
# Solo E2E: siembra registros antiguos saltando el trigger de ventana. Debe ser local (127.0.0.1).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
